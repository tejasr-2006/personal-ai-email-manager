# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# ---------- general ----------
# use "production" on Render
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=personal_ai_email

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Gmail ----------
# Local: put credentials.json / token.json in backend/ (run scripts/gmail_auth.py once).
# Render: paste the one-line JSON printed by scripts/gmail_auth.py here.
GOOGLE_TOKEN_JSON=
# Optional custom file locations:
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
GMAIL_QUERY=in:inbox

# ---------- CORS ----------
# Comma-separated list of frontend URLs allowed to call this API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, e.g. to also allow Vercel preview deployments:
# ALLOWED_ORIGIN_REGEX=https://your-app-.*\.vercel\.app

# ---------- optional API protection ----------
# If set, every /emails request must send header  X-API-Key: <this value>
API_KEY=

# ---------- optional tuning (defaults shown) ----------
# SYNC_MAX_EMAILS=20
# SYNC_TIME_BUDGET_SECONDS=60
# MAX_BODY_CHARS=10000
# ENABLE_DOCS=true

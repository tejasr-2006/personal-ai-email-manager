# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.

# ---------- general ----------
# use "production" on Render
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=personal_ai_email

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Gmail ----------
# Local: put credentials.json / token.json in backend/ (run scripts/gmail_auth.py once).
# Render: paste the one-line JSON printed by scripts/gmail_auth.py here.
GOOGLE_TOKEN_JSON=
# Optional custom file locations:
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
GMAIL_QUERY=in:inbox

# ---------- CORS ----------
# Comma-separated list of frontend URLs allowed to call this API (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example (exact URL, https, no trailing slash, NEVER "*"):
# ALLOWED_ORIGINS=https://personal-ai-email-manager.vercel.app

# ---------- login (server-side only; never put these in the frontend) ----------
# The password you type on the login page:
AUTH_PASSWORD=
# Random secret, 32+ characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session lifetime in seconds (default 86400 = 24 h)
# SESSION_MAX_AGE_SECONDS=86400
# Cookie flags. Defaults: production => Secure + SameSite=None (needed for Vercel -> Render),
# development => SameSite=Lax over http. Normally leave these unset.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ---------- server-to-server key (optional) ----------
# Lets scripts/other servers call /emails with header  X-API-Key: <value>.
# The browser never receives it. Leave empty if you don't need it.
API_KEY=

# ---------- optional tuning (defaults shown) ----------
# SYNC_MAX_EMAILS=20
# SYNC_TIME_BUDGET_SECONDS=60
# MAX_BODY_CHARS=10000
# ENABLE_DOCS=true
